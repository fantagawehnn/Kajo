{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kajo",
  "main": "./worker.js",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "previews": {},
  "ratelimits": [
    {
      "name": "COACH_RATE_LIMITER",
      "namespace_id": "987654321",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
